# Vorlage für die .env. Kopieren nach .env und Werte eintragen.
# Crossreference: Jede Variable steht auch in .env.
# Neu anlegen, umbenennen oder löschen immer in BEIDEN Dateien.

postgres_url=host-oder-ip
postgres_port=5432
postgres_db_name=datenbankname
postgres_user=benutzer
postgres_pw=passwort

# SFTP (Dateispeicher). Beim Wechsel auf ein NAS ändern sich nur sftp_host und sftp_host_key.
# User und Passwort gelten für den Container (Compose) und den Client (Backend) zugleich.
sftp_host=host-oder-ip
sftp_port=22
sftp_user=benutzer
sftp_pw=passwort
# öffentlicher Host-Key des Servers: EIN Wert, Typ und Schlüssel durch Leerzeichen getrennt, ohne Anführungszeichen.
# Beim Container ist das die Ausgabe von: cut -d " " -f 1,2 ../docker_mounts/sftp/ssh_host_ed25519_key.pub
sftp_host_key=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI...
# Hat mit dem Host-Key nichts zu tun. Optional ein Dateipfad: Dann meldet sich das Backend mit dieser Schlüsseldatei an
# statt mit sftp_pw. Normalerweise leer.
sftp_private_key_path=

# Solr (Suchindex, Container app1_solr). User und Passwort gelten für den Container (Basic Auth) und das Backend zugleich.
# Nur Buchstaben und Ziffern: Die Werte laufen durch Shell, Compose und HTTP-Header.
solr_host=host-oder-ip
solr_port=8983
solr_user=benutzer
solr_pw=passwort
# Die Kerne, die der Container beim Start anlegt: die Keys aus dem SolrManager, durch Komma getrennt, ohne Leerzeichen.
solr_cores=DMS,ARTIKEL

# Entra: die Identität des Backends gegenüber Microsoft (Paket graph/entra). Tenant und App-Registrierung.
entra_tenant_id=tenant-id
entra_client_id=client-id
# nur, wenn die App-Registrierung ein Secret nutzt. Mit Zertifikat bleibt es leer.
entra_client_secret=
# privater Schlüssel und Zertifikat des Backends (PEM, PKCS#8), außerhalb des Repos. Das Zertifikat wird in der
# App-Registrierung unter „Zertifikate & Geheimnisse“ hochgeladen.
entra_private_key_path=/pfad/zu/app1-entra.key
entra_certificate_path=/pfad/zu/app1-entra.crt

# Microsoft Graph, Mailversand (Paket graph/mail): das Postfach im Tenant, in dessen Namen das System verschickt
graph_mail_sender=postfach@firma.de

# Adresse des Frontends, z. B. für den Aktivierungslink in der 2FA-Mail. Beim Entwickeln der Vite-Server.
frontend_url=http://localhost:3000
