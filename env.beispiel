# Vorlage für die .env. Kopieren nach .env und Werte eintragen.
# Crossreference: Jede Variable steht auch in .env.
# Neu anlegen, umbenennen oder löschen immer in BEIDEN Dateien.

postgres_url=host-oder-ip
postgres_port=5432
postgres_db_name=datenbankname
postgres_user=benutzer
postgres_pw=passwort

# SFTP (Dateispeicher). Beim Wechsel auf ein NAS ändern sich nur sftp_host und sftp_host_key.
# User und Passwort gelten für den Container (Compose) und den Client (Backend) zugleich.
sftp_host=host-oder-ip
sftp_port=22
sftp_user=benutzer
sftp_pw=passwort
# öffentlicher Host-Key des Servers: EIN Wert, Typ und Schlüssel durch Leerzeichen getrennt, ohne Anführungszeichen.
# Beim Container ist das die Ausgabe von: cut -d " " -f 1,2 ../docker_mounts/sftp/ssh_host_ed25519_key.pub
sftp_host_key=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI...
# Hat mit dem Host-Key nichts zu tun. Optional ein Dateipfad: Dann meldet sich das Backend mit dieser Schlüsseldatei an
# statt mit sftp_pw. Normalerweise leer.
sftp_private_key_path=
