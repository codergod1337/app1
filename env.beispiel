# Vorlage für die .env. Kopieren nach .env und Werte eintragen.
# Crossreference: Jede Variable steht auch in .env.
# Neu anlegen, umbenennen oder löschen immer in BEIDEN Dateien.

postgres_url=host-oder-ip
postgres_port=5432
postgres_db_name=datenbankname
postgres_user=benutzer
postgres_pw=passwort
