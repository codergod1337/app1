<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>codergod1337</groupId>
	<artifactId>app1-spring</artifactId>
	<version>0.1</version>
	<name>gebieter</name>
	<description>Codergod1337's Fullstack App</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>25</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- Filterkette, BCrypt (spring-security-crypto steckt hier mit drin) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- JWT signieren und prüfen (Nimbus) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- SFTP-Client (gepflegter JSch-Fork, pure Java) für den Dateispeicher, siehe system/sftp.
		     Version am 2026-10-02 über Maven Central geprüft. -->
		<dependency>
			<groupId>com.github.mwiede</groupId>
			<artifactId>jsch</artifactId>
			<version>2.28.7</version>
		</dependency>
		<!-- Apache Tika liest Text und Metadaten aus den Bytes jeder hochgeladenen Datei (dms/service/TikaService).
		     tika-core allein kennt kein Format, das Standardpaket bringt die Parser für PDF, Office, Bilder, Mails und
		     Archive mit. Version wie in der Vorlage, dort am 2026-07-29 als stabil geprüft. -->
		<dependency>
			<groupId>org.apache.tika</groupId>
			<artifactId>tika-core</artifactId>
			<version>3.3.2</version>
		</dependency>
		<dependency>
			<groupId>org.apache.tika</groupId>
			<artifactId>tika-parsers-standard-package</artifactId>
			<version>3.3.2</version>
		</dependency>
		<!-- Spracherkennung aus dem Text, den Tika liefert (dms/service/DmsDocumentLanguageService): Optimaize
		     rechnet offline mit eingebauten Sprachprofilen, kein Dienst, keine Modelle zum Nachladen. -->
		<dependency>
			<groupId>org.apache.tika</groupId>
			<artifactId>tika-langdetect-optimaize</artifactId>
			<version>3.3.2</version>
		</dependency>
		<!-- SolrJ, der Java-Client für Solr, Version wie der Container solr:10.0.0. Der Jetty-Client ist in Solr 10 ein
		     eigenes Modul (solr-solrj-jetty) und liefert HttpJettySolrClient (solr/client/SolrClientRegistry). Nie der
		     HttpJdkSolrClient: Der hängt nach einem Verbindungsabbruch für immer, ohne Fehler (SOLR-17707, in 10.0.0
		     ungefixt), Erkenntnis aus der Vorlage. -->
		<dependency>
			<groupId>org.apache.solr</groupId>
			<artifactId>solr-solrj</artifactId>
			<version>10.0.0</version>
		</dependency>
		<dependency>
			<groupId>org.apache.solr</groupId>
			<artifactId>solr-solrj-jetty</artifactId>
			<version>10.0.0</version>
		</dependency>
		<!-- Bildleser für das Vorschaubild (dms/service/PreviewImageService), reines Java, registrieren sich selbst bei
		     ImageIO. imageio-jpeg ersetzt den JPEG-Leser des JDK, der an CMYK- und manchen progressiven JPEGs scheitert,
		     imageio-webp liest WebP. Version am 2026-10-03 über Maven Central geprüft. -->
		<dependency>
			<groupId>com.twelvemonkeys.imageio</groupId>
			<artifactId>imageio-jpeg</artifactId>
			<version>3.12.0</version>
		</dependency>
		<dependency>
			<groupId>com.twelvemonkeys.imageio</groupId>
			<artifactId>imageio-webp</artifactId>
			<version>3.12.0</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
